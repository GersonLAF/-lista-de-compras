generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PrioridadeItem {
  ALTA
  MÉDIA
  BAIXA
}

model ItemCompra {
  id        String       @id @default(uuid())
  title    String
  done    Boolean @default(false)
  prioridade    PrioridadeItem
  userId    String       
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
